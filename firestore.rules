rules_version = '2';

// Who may read or change what in Kosha. These rules are the enforcement point:
// the web app only mirrors them (shared/policy.ts) to hide buttons and give clear messages.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userDoc()); }
    function me() { return get(userDoc()).data; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isShop() { return hasProfile() && me().role == 'business'; }
    function isVerifiedLender() { return hasProfile() && me().role == 'lender' && me().get('status', 'pending') == 'verified'; }
    // Does the shop's consent cover the signed-in lender's organisation?
    function covers(consent) { return consent.scope == 'all' || (consent.scope == 'selected' && me().orgId in consent.lenderIds); }
    // The demo accounts' password is public. Demo accounts, and lenders verified by the demo admin ("sandbox"),
    // live in a sandbox: they can only ever see passports built by demo accounts, never a real shop's.
    function isDemo() { return me().get('demo', false) == true; }
    function sandboxed() { return isDemo() || me().get('sandbox', false) == true; }
    // A verified lender sees a passport when the shop shared it with its organisation, and, if the lender is
    // sandboxed, only when it is a demo passport.
    function lenderSees(p) { return isVerifiedLender() && covers(p.consent) && (!sandboxed() || p.get('demo', false) == true); }
    function passport(id) { return get(/databases/$(database)/documents/passports/$(id)).data; }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── accounts
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      // Anyone may open a shop account or a lender account. A new lender starts as pending:
      // nobody can make themselves verified, an admin, or a demo account.
      allow create: if signedIn() && userId == uid()
        && request.resource.data.id == uid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['id', 'role', 'name', 'email', 'org', 'orgId', 'status', 'createdAt', 'orgType', 'regNo'])
        && request.resource.data.name is string && request.resource.data.org is string
        && (
          (request.resource.data.role == 'business' && !('status' in request.resource.data) && !('orgId' in request.resource.data))
          || (request.resource.data.role == 'lender' && request.resource.data.status == 'pending' && request.resource.data.orgId is string
              && request.resource.data.regNo is string && request.resource.data.regNo.size() >= 4)
        );
      allow update: if signedIn() && (
        // an account may only record "signed out on every device"
        (userId == uid() && changes(['signedOutBefore']))
        // Kosha staff verify or reject lender accounts (never the demo lender). The demo admin's approvals are
        // sandboxed, and it cannot touch a lender a real admin verified.
        || (isAdmin() && resource.data.role == 'lender' && resource.data.get('demo', false) != true
            && changes(['status', 'statusNote', 'verifiedAt', 'sandbox']) && request.resource.data.status in ['verified', 'rejected']
            && request.resource.data.get('sandbox', false) == isDemo()
            && (!isDemo() || resource.data.get('status', 'pending') != 'verified' || resource.data.get('sandbox', false) == true))
      );
      allow delete: if false;
    }

    // Verified lender organisations a shop can choose to share with.
    match /orgs/{orgId} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.id == orgId && request.resource.data.get('sandbox', false) == isDemo();
      // the demo admin can never relabel an organisation a real admin verified
      allow update: if isAdmin() && request.resource.data.id == orgId && request.resource.data.get('sandbox', false) == isDemo()
        && (!isDemo() || resource.data.get('sandbox', false) == true);
      allow delete: if false;
    }

    // ── passports: the owner, and verified lenders the shop shared with, read the full passport
    match /passports/{id} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || lenderSees(resource.data));
      allow create: if isShop()
        && request.resource.data.id == id
        && request.resource.data.ownerId == uid()
        && request.resource.data.get('demo', false) == isDemo()
        && request.resource.data.consent.scope in ['all', 'selected']
        && !('decisions' in request.resource.data) && !('access' in request.resource.data);
      // After issue, only the shop's consent can change; the score and evidence are fixed.
      allow update: if signedIn() && resource.data.ownerId == uid()
        && changes(['consent'])
        && request.resource.data.consent.scope in ['all', 'selected', 'none'];
      allow delete: if false;

      // One decision per lender organisation. The shop sees all; a lender only its own.
      match /decisions/{orgId} {
        allow read: if signedIn() && (passport(id).ownerId == uid()
          || (me().get('orgId', '') == orgId && lenderSees(passport(id))));
        allow create, update: if me().get('orgId', '') == orgId && lenderSees(passport(id))
          && request.resource.data.lenderId == uid() && request.resource.data.orgId == orgId
          && request.resource.data.status in ['approved', 'more_info', 'declined'];
        allow delete: if false;
      }

      // Every full view by a lender, shown to the shop.
      match /access/{entry} {
        allow read: if signedIn() && (passport(id).ownerId == uid() || resource.data.lenderId == uid());
        allow create: if lenderSees(passport(id)) && request.resource.data.lenderId == uid();
        allow update, delete: if false;
      }
    }

    // ── one identity, one shop: a PAN's one-way fingerprint, claimed by the first shop that uses it.
    // Only the claimant can read its claim; anyone else's attempt to claim it is refused, which is the signal.
    match /identities/{fingerprint} {
      allow get: if signedIn() && resource.data.ownerId == uid();
      allow create: if isShop() && request.resource.data.ownerId == uid() && request.resource.data.keys().hasOnly(['ownerId', 'at']);
      allow list, update, delete: if false;
    }

    // ── the redacted public record behind every QR code: anyone may read it.
    // Only the owner writes it, and its score, band, status and seal must match the passport.
    match /public/{id} {
      // open one record by its number (as the QR does), but never list them all
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.ownerId == uid()
        && passport(id).ownerId == uid()
        && request.resource.data.id == id
        && request.resource.data.score == passport(id).score
        && request.resource.data.band == passport(id).band
        && request.resource.data.status == passport(id).offer.status
        && request.resource.data.seal == passport(id).seal;
      allow delete: if false;
    }

    // ── append-only audit log. Staff read it (the demo admin only the demo's own activity);
    // a shop reads the entries about its own passports.
    match /audit/{entryId} {
      allow read: if (isAdmin() && (!isDemo() || resource.data.get('demo', false) == true)) || (signedIn() && resource.data.get('ownerId', '') == uid());
      allow create: if request.resource.data.id == entryId
        && (
          (signedIn() && request.resource.data.actorId == uid()
            && (!('ownerId' in request.resource.data) || passport(request.resource.data.passportId).ownerId == request.resource.data.ownerId))
          || (request.resource.data.actorId == null && request.resource.data.type in ['login_failed', 'login_locked'])
        );
      allow update, delete: if false;
    }
  }
}
