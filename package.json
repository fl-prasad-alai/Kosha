{
  "name": "kosha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-cache.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project demo-kosha",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8180 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed.mjs demo-kosha",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "firebase": "^12.19.0",
    "gsap": "^3.12.5",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "react-use-measure": "^2.1.7",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
