# Local development: a Gemini API key from AI Studio
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-2.5-flash

# Or Vertex AI (what Cloud Run uses)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global

# Optional
# KOSHA_MAPS_GROUNDING=1        # Grounding with Google Maps (billed projects)
# KOSHA_STORE=firestore         # store passports in Firestore instead of local files
# KOSHA_HOURLY_BUDGET=80        # Gemini calls per device per hour
