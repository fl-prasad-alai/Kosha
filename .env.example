# A Gemini API key from Google AI Studio (used by the browser; restrict it to your site's domain)
GEMINI_API_KEY=
# VITE_GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash

# Firebase web app config (Project settings → Your apps). Not needed with the emulators.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulators (put these in .env.development.local)
# VITE_FIREBASE_EMULATORS=1
# VITE_FIREBASE_PROJECT_ID=demo-kosha
